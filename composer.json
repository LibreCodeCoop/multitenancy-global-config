{
    "name": "librecodecoop/multitenancy-global-config",
    "description": "Multi-tenant global config loader for Nextcloud: resolves $CONFIG per request host from a domain config matrix",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "LibreCode\\MultiTenancyGlobalConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LibreCode\\MultiTenancyGlobalConfig\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
